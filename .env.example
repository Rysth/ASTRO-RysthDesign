# Copia este archivo a .env — nunca commitear .env real.

# Solo se usa en scripts/fetch-resenas.mjs (Node), nunca llega al cliente.
GOOGLE_PLACES_API_KEY=

# Formato "ChIJ..." de la Places API — NO es el CID que trae el link de
# Google Maps (el que aparece como "0x...:0x..." en la URL). Se obtiene con
# el Place ID Finder oficial de Google:
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
