---
import { Image } from "astro:assets";
import brand from "@/assets/images/brand/brand.svg";
import { waLink } from "@/data/site.ts";

const links = [
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#precios", label: "Precios" },
];
---

<header
  class="sticky top-0 z-50 border-b border-slate bg-void/90 backdrop-blur"
>
  <nav
    class="mx-auto flex h-16 max-w-screen-xl items-center justify-between gap-6 px-4 md:px-6"
  >
    <a href="/" class="flex items-center" aria-label="RysthDesign, inicio">
      <Image src={brand} alt="RysthDesign" class="logo h-8 w-auto" />
    </a>

    <div class="flex items-center gap-3">
      <ul class="mr-4 hidden items-center gap-8 md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-mono text-eyebrow uppercase text-smoke transition-colors duration-150 ease-out hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        data-theme-toggle
        aria-label="Cambiar a modo claro"
        class="inline-flex items-center justify-center rounded-button p-3 border border-slate text-smoke transition-colors duration-150 ease-out hover:border-violeta hover:text-white"
      >
        <!-- Lucide sun / moon, outline 1.5px -->
        <svg
          class="icon-sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg
          class="icon-moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <a
        href={waLink("Hola, vi tu web y quiero saber cómo funciona RysthDesign.")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-button border border-slate px-4 py-2 text-small font-medium text-white transition-colors duration-150 ease-out hover:border-violeta"
      >
        <!-- Lucide message-circle, outline 1.5px -->
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="text-violeta"
        >
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
        </svg>
        WhatsApp
      </a>
    </div>
  </nav>
</header>

<style>
  /* En oscuro se ofrece el sol (pasar a claro); en claro, la luna. */
  .icon-moon {
    display: none;
  }

  :global(html[data-theme="light"]) .icon-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .icon-moon {
    display: block;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const root = document.documentElement;

  function sync() {
    const light = root.dataset.theme === "light";
    toggle?.setAttribute(
      "aria-label",
      light ? "Cambiar a modo oscuro" : "Cambiar a modo claro",
    );
  }

  sync();

  toggle?.addEventListener("click", () => {
    const light = root.dataset.theme !== "light";
    if (light) root.dataset.theme = "light";
    else delete root.dataset.theme;

    try {
      localStorage.setItem("theme", light ? "light" : "dark");
    } catch {}

    sync();
  });
</script>
