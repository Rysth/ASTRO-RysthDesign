---
import { Image } from "astro:assets";
import brand from "@/assets/images/brand/brand.svg";
import { waLink } from "@/data/site.ts";

const links = [
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#precios", label: "Precios" },
];
---

<header
  class="sticky top-0 z-50 border-b border-slate bg-void/90 backdrop-blur"
>
  <nav
    class="mx-auto flex h-16 max-w-screen-xl items-center justify-between gap-6 px-4 md:px-6"
  >
    <a href="/" class="flex items-center" aria-label="RysthDesign, inicio">
      <Image src={brand} alt="RysthDesign" class="h-8 w-auto" />
    </a>

    <div class="flex items-center gap-8">
      <ul class="hidden items-center gap-8 md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-mono text-eyebrow uppercase text-smoke transition-colors duration-150 ease-out hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={waLink("Hola, vi tu web y quiero saber cómo funciona RysthDesign.")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-button border border-slate px-4 py-2 text-small font-medium text-white transition-colors duration-150 ease-out hover:border-violeta"
      >
        <!-- Lucide message-circle, outline 1.5px -->
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="text-violeta"
        >
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
        </svg>
        WhatsApp
      </a>
    </div>
  </nav>
</header>
