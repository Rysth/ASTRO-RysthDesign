---
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { proceso } from "@/data/proceso.ts";
---

<section id="proceso" class="mx-auto max-w-screen-xl scroll-mt-16 px-4 py-16 md:px-6 md:py-24">
  <SectionHeader eyebrow="Proceso" title="Cuatro pasos, sin sorpresas" />

  <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      proceso.map((paso) => (
        <li class="flex flex-col gap-3 border-t border-slate pt-4">
          <span class="text-h3 font-mono text-violeta">{paso.numero}</span>
          <h3 class="text-h3 text-white">{paso.titulo}</h3>
          <p class="text-small text-smoke">{paso.detalle}</p>
          <p class="text-eyebrow font-mono uppercase text-smoke">
            {paso.duracion}
          </p>
        </li>
      ))
    }
  </ol>

  <p class="text-small mt-8 text-smoke">
    El reloj corre desde que el cliente entrega textos e imágenes, no desde
    que paga.
  </p>
</section>
