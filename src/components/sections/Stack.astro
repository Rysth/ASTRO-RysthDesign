---
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { stack } from "@/data/stack.ts";
---

<section class="mx-auto max-w-screen-xl px-4 py-16 md:px-6 md:py-24">
  <Eyebrow text="Stack" />
  <ul class="mt-8 flex flex-wrap items-center gap-x-12 gap-y-4">
    {
      stack.map((tech) => (
        <li class="font-mono text-body uppercase tracking-[0.05em] text-smoke">
          {tech}
        </li>
      ))
    }
  </ul>
</section>
