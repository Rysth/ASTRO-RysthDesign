---
import SectionHeader from "@/components/ui/SectionHeader.astro";

const preguntas = [
  {
    pregunta: "¿Puedo cambiar los precios yo mismo?",
    respuesta:
      "Los precios de consulta, vacunación y demás servicios entran dentro del soporte básico de la anualidad. Me escribes por WhatsApp y lo actualizo el mismo día.",
  },
  {
    pregunta: "¿Se pueden agendar citas desde el sitio?",
    respuesta:
      "El botón de WhatsApp con mensaje prellenado hace ese trabajo — el cliente escribe y agenda directo con vos, sin que tengas que administrar un calendario aparte.",
  },
  {
    pregunta: "¿Sirve si ahora mismo solo tengo Instagram?",
    respuesta:
      "Sí, de hecho es el caso más común. El sitio no reemplaza tu Instagram, le da a tu veterinaria un lugar donde aparecer en Google cuando alguien busca \"veterinaria cerca de mí\" — ahí Instagram no aparece.",
  },
  {
    pregunta: "¿Cuánto demora?",
    respuesta:
      "7 días la Landing y 7 días el Sitio Informativo, desde que me entregas los precios, el equipo y las fotos de tus pacientes.",
  },
];
---

<section
  id="faq"
  class="mx-auto max-w-screen-xl scroll-mt-16 px-4 py-16 md:px-6 md:py-24"
>
  <SectionHeader eyebrow="Preguntas frecuentes" title="Antes de escribir" />

  <div class="mt-12 flex max-w-[75ch] flex-col gap-4">
    {
      preguntas.map((item) => (
        <details class="group rounded-card border border-slate bg-carbon p-6">
          <summary class="text-body flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
            {item.pregunta}
            <span class="font-mono text-smoke transition-transform duration-150 ease-out group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="text-small mt-4 text-smoke">{item.respuesta}</p>
        </details>
      ))
    }
  </div>
</section>
