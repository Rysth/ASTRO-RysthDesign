---
import { Image } from "astro:assets";
import brand from "@/assets/images/brand/brand.svg";
import { waLink, SOCIAL_LINKS } from "@/data/site.ts";

const links = [
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#precios", label: "Precios" },
];

const legales = [
  { href: "/privacidad", label: "Privacidad" },
  { href: "/terminos", label: "Términos" },
];

const social = [
  { href: SOCIAL_LINKS.instagram, label: "Instagram" },
  { href: SOCIAL_LINKS.facebook, label: "Facebook" },
  { href: SOCIAL_LINKS.tiktok, label: "TikTok" },
  {
    href: waLink("Hola, vi tu web y quiero saber cómo funciona RysthDesign."),
    label: "WhatsApp",
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-slate">
  <div
    class="mx-auto flex max-w-screen-xl flex-col items-center justify-between gap-6 px-4 py-8 text-center md:flex-row md:px-6 md:text-left"
  >
    <div class="flex flex-col items-center gap-2 md:items-start">
      <Image src={brand} alt="RysthDesign" class="h-6 w-auto" />
      <p class="text-small font-mono text-smoke">Web · Rendimiento</p>
    </div>

    <ul class="flex flex-wrap items-center justify-center gap-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-small text-smoke transition-colors duration-150 ease-out hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      {
        social.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-small text-smoke transition-colors duration-150 ease-out hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-col items-center gap-2 md:items-end">
      <p class="text-small text-smoke">© {year} RysthDesign</p>
      <ul class="flex items-center gap-4">
        {
          legales.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-small text-smoke transition-colors duration-150 ease-out hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
