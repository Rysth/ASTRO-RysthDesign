---
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import Chevron from "@/components/ui/Chevron.astro";
import RaceBars from "@/components/RaceBars.astro";
import { waLink } from "@/data/site.ts";
---

<section class="mx-auto max-w-screen-xl px-4 pb-16 pt-12 md:px-6 md:pb-24 md:pt-16">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col items-start gap-6">
      <Eyebrow text="Web · Rendimiento" />
      <h1 class="text-display text-white">
        Sitios que cargan en menos de un segundo
      </h1>
      <p class="text-body max-w-[65ch] text-smoke">
        Y que aparecen cuando te buscan en Google. Astro estático, 95+ en
        Lighthouse móvil, ficha de Google Business lista desde el día uno.
      </p>
      <div class="flex flex-wrap items-center gap-6">
        <Button
          href={waLink(
            "Hola, vi tu web y quiero saber cómo funciona el sistema de RysthDesign.",
          )}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
        >
          Hablar por WhatsApp
        </Button>
        <Button href="#proceso" variant="secondary">
          Ver cómo funciona
          <Chevron size={10} />
        </Button>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <RaceBars />
    </div>
  </div>
</section>
