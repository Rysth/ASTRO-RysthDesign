---
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import Chevron from "@/components/ui/Chevron.astro";
import { waLink } from "@/data/site.ts";
---

<section class="mx-auto max-w-screen-xl px-4 pb-16 pt-12 md:px-6 md:pb-24 md:pt-16">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col items-start gap-6">
      <Eyebrow text="Web · Automatización" />
      <h1 class="text-display text-white">
        Sitios web que no se quedan quietos
      </h1>
      <p class="text-body max-w-[65ch] text-smoke">
        Capturan al cliente, responden por WhatsApp y te avisan al instante
        — sin que tengas que estar pendiente.
      </p>
      <div class="flex flex-wrap items-center gap-6">
        <Button
          href={waLink(
            "Hola, vi tu web y quiero saber cómo funciona el sistema de RysthDesign.",
          )}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
        >
          Hablar por WhatsApp
        </Button>
        <Button href="#proceso" variant="secondary">
          Ver cómo funciona
          <Chevron size={10} />
        </Button>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <div
        data-hero-mockup
        class="w-full max-w-sm rounded-card border border-slate bg-carbon p-4"
      >
        <p class="text-eyebrow mb-4 font-mono uppercase text-smoke">
          WhatsApp · en vivo
        </p>
        <div class="flex flex-col gap-3">
          <div
            class="text-body max-w-[85%] self-start rounded-card bg-slate px-4 py-3 text-white"
          >
            Hola, vi su página, ¿hacen sitios web?
          </div>
          <div
            data-bubble-reply
            class="text-body max-w-[85%] translate-y-3 self-end rounded-card bg-senal/15 px-4 py-3 text-white opacity-0 transition-all duration-150 ease-out"
          >
            ¡Hola! Sí, cuéntame qué necesitas y te respondo en minutos.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const mockup = document.querySelector("[data-hero-mockup]");
  const reply = document.querySelector("[data-bubble-reply]");

  function reveal() {
    reply?.classList.remove("opacity-0", "translate-y-3");
  }

  if (mockup && reply) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) {
      reveal();
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setTimeout(reveal, 2000);
              io.disconnect();
            }
          });
        },
        { threshold: 0.3 },
      );
      io.observe(mockup);
    }
  }
</script>
