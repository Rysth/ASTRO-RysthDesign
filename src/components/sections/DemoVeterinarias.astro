---
import { Image } from "astro:assets";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import { demo } from "@/data/demo.ts";
---

<section id="el-demo" class="mx-auto max-w-screen-xl scroll-mt-16 px-4 py-16 md:px-6 md:py-24">
  <SectionHeader
    eyebrow="El demo"
    title="Así se ve una veterinaria hecha con RysthDesign"
  />

  <div class="mt-12">
    {
      demo.captura && demo.url ? (
        <a
          href={demo.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block overflow-hidden rounded-card border border-slate bg-carbon transition-colors duration-150 ease-out hover:border-violeta"
        >
          <Image
            src={demo.captura}
            alt={`Captura del sitio demo ${demo.nombre}`}
            width={1200}
            height={750}
            loading="lazy"
            format="webp"
            class="w-full object-cover object-top"
          />
        </a>
      ) : (
        <div class="flex flex-col items-start gap-4 rounded-card border border-slate bg-carbon p-8">
          <p class="text-body text-smoke">
            El demo está en construcción — un sitio de muestra completo, con
            servicios, precios y equipo ya cargados, para que veas
            exactamente lo que recibe tu veterinaria.
          </p>
          <Button
            href="#el-servicio"
            variant="secondary"
          >
            Ver qué incluye mientras tanto
          </Button>
        </div>
      )
    }
  </div>
</section>
