---
import SectionHeader from "@/components/ui/SectionHeader.astro";

// Cifras en TODO: son cifras de negocio, no las inventamos — confirmar antes de publicar.
const datos = [
  {
    numero: "TODO: seg",
    label: "Lo que tarda en cargar un sitio de WordPress típico en celular",
  },
  {
    numero: "TODO: %",
    label: "Visitantes que abandonan un sitio que tarda más de 3 segundos",
  },
  {
    numero: "0.6 seg",
    label: "Lo que tarda en cargar un sitio hecho con RysthDesign",
  },
];
---

<section class="mx-auto max-w-screen-xl px-4 py-16 md:px-6 md:py-24">
  <SectionHeader
    eyebrow="El problema"
    title="Cada segundo de carga es un cliente que se va con otro"
  />

  <div class="mt-12 grid gap-8 sm:grid-cols-3">
    {
      datos.map((dato) => (
        <div class="flex flex-col gap-2">
          <p class="text-display text-white">{dato.numero}</p>
          <p class="text-eyebrow font-mono uppercase text-smoke">
            {dato.label}
          </p>
        </div>
      ))
    }
  </div>
</section>
