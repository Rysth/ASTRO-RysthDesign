---
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { datosAuditoria, fuenteAuditoria } from "@/data/auditoria.ts";

// Cifras de la auditoría propia (src/data/auditoria.ts): sin presencia web,
// solo Instagram/Facebook y PageSpeed promedio. Nada inventado.
const [sinPresencia, , soloRedes, , pageSpeed] = datosAuditoria;

const datos = [sinPresencia, soloRedes, pageSpeed];
---

<section class="mx-auto max-w-screen-xl px-4 py-16 md:px-6 md:py-24">
  <SectionHeader
    eyebrow="El problema"
    title="Auditamos 190 negocios locales en Guayaquil: casi nadie aparece en Google"
    description="Revisamos cada una en Google Maps, sitio por sitio. El mismo patrón se repite en la mayoría de los rubros locales."
  />

  <div class="mt-12 grid gap-8 sm:grid-cols-3">
    {
      datos.map((dato) => (
        <div class="flex flex-col gap-2">
          <p class="text-display text-white">{dato.numero}</p>
          <p class="text-eyebrow font-mono uppercase text-smoke">
            {dato.label}
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-8 text-xs font-mono text-smoke">{fuenteAuditoria}</p>
</section>
