---
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Star from "@/components/ui/Star.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import resenas from "@/data/resenas.json";

const estrellasPromedio = Math.round(resenas.rating);
// Ritmo del marquee: ~5s por tarjeta, para que la velocidad se sienta igual
// sin importar cuántas reseñas haya.
const duracionMarquee = `${resenas.resenas.length * 5}s`;
---

{
  resenas.mostrar && (
<section
  id="resenas"
  role="region"
  aria-label="Reseñas de clientes"
  class="mx-auto max-w-screen-xl px-4 py-16 md:px-6 md:py-24"
>
  <Eyebrow text="Reseñas" />

  <div
    class="mt-6 flex flex-wrap items-center justify-between gap-6 border-b border-slate pb-8"
  >
    <div class="flex items-center gap-4">
      <p class="font-display text-h2 text-white">{resenas.rating.toFixed(1)}</p>
      <div class="flex flex-col gap-1">
        <div
          class="flex items-center gap-1"
          aria-label={`Calificación ${resenas.rating} de 5 estrellas`}
        >
          {
            Array.from({ length: 5 }).map((_, i) => (
              <Star size={16} filled={i < estrellasPromedio} />
            ))
          }
        </div>
        <p class="text-small font-mono text-smoke">
          {resenas.total} reseñas en Google
        </p>
      </div>
    </div>

    {
      resenas.perfilUrl && (
        <a
          href={resenas.perfilUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-small text-violeta transition-colors duration-150 ease-out hover:text-violeta-deep"
        >
          Ver todas en Google
        </a>
      )
    }
  </div>

  {
    resenas.resenas.length > 0 ? (
      <Fragment>
        {/* Escritorio/tablet: arrastras vos, con mouse o trackpad. */}
        <ul class="pista m-0 mt-8 hidden list-none p-0 md:flex" tabindex="0">
          {resenas.resenas.map((r) => (
            <li>
              <ReviewCard resena={r} />
            </li>
          ))}
        </ul>

        {/* Móvil: avanza solo. El checkbox oculto es el control de pausa —
            100% CSS, sin JS, y accesible por teclado/lector de pantalla. */}
        <div
          class="marquee-viewport mt-8 md:hidden"
          style={`--marquee-duration: ${duracionMarquee}`}
        >
          <input type="checkbox" id="pausar-resenas" class="peer sr-only" />

          <ul class="marquee-track m-0 list-none p-0">
            {resenas.resenas.map((r) => (
              <li class="marquee-item">
                <ReviewCard resena={r} />
              </li>
            ))}
            {resenas.resenas.map((r) => (
              <li class="marquee-item" aria-hidden="true" inert>
                <ReviewCard resena={r} />
              </li>
            ))}
          </ul>

          <label
            for="pausar-resenas"
            class="mt-4 inline-block cursor-pointer text-eyebrow font-mono uppercase text-smoke peer-checked:hidden"
          >
            Pausar autoplay
          </label>
          <label
            for="pausar-resenas"
            class="mt-4 hidden cursor-pointer text-eyebrow font-mono uppercase text-violeta peer-checked:inline-block"
          >
            Reanudar autoplay
          </label>
        </div>
      </Fragment>
    ) : (
      <p class="mt-8 text-small text-smoke">
        Reseñas en camino.
        {resenas.perfilUrl && (
          <>
            {" "}
            Mientras tanto, visítanos en{" "}
            <a
              href={resenas.perfilUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-violeta hover:text-violeta-deep"
            >
              Google
            </a>
            .
          </>
        )}
      </p>
    )
  }
</section>
  )
}

<style>
  .pista {
    /* display lo maneja Tailwind (hidden md:flex) — no lo fijes acá o
       pisa el "hidden" en móvil. */
    gap: var(--space-16);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-8);
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  .pista > * {
    scroll-snap-align: start;
    flex: 0 0 clamp(280px, 80vw, 360px);
  }

  .marquee-viewport {
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    gap: var(--space-16);
    width: max-content;
    animation: resenas-marquee var(--marquee-duration, 24s) linear infinite;
  }
  .marquee-item {
    flex: 0 0 clamp(280px, 80vw, 360px);
  }
  @keyframes resenas-marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* La pista trae las reseñas duplicadas para el loop. -50% solo, sin
         ajuste, deja un salto de medio gap al reiniciar — se resta ese medio
         gap para que el loop sea perfectamente continuo. */
      transform: translateX(calc(-50% - var(--space-16) / 2));
    }
  }
  /* Selector por ID a propósito: le gana en especificidad al shorthand
     `animation` de arriba, que si no reinicia animation-play-state a
     "running" y el pausado (hover/foco/checkbox) nunca se nota. */
  #pausar-resenas:checked ~ .marquee-track,
  .marquee-track:hover,
  .marquee-track:focus-within {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }
    /* Con reduced-motion, la versión de escritorio (arrastrable, sin
       autoplay) reemplaza al marquee incluso en móvil. */
    .marquee-viewport {
      display: none;
    }
    .pista {
      display: flex !important;
    }
  }
</style>
