---
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Star from "@/components/ui/Star.astro";
import OpinionCard, { type Opinion } from "@/components/OpinionCard.astro";
import { testimonios } from "@/data/testimonios.ts";
import resenas from "@/data/resenas.json";

const propias: Opinion[] = testimonios.map((t) => ({
  texto: t.texto,
  autor: t.autor,
  detalle: `${t.cargo} · ${t.empresa}`,
  esGoogle: false,
}));

// resenas.mostrar es el interruptor manual de las reseñas de Google (ver
// scripts/fetch-resenas.mjs) — si está en false, no se suman acá aunque
// haya datos cacheados.
const google: Opinion[] = resenas.mostrar
  ? resenas.resenas.map((r) => ({
      texto: r.texto,
      autor: r.autor,
      detalle: r.fecha,
      estrellas: r.estrellas,
      esGoogle: true,
    }))
  : [];

const opiniones = [...propias, ...google];

// Ritmo del marquee: ~5s por tarjeta, para que la velocidad se sienta igual
// sin importar cuántas opiniones haya.
const duracionMarquee = `${opiniones.length * 5}s`;
---

{
  opiniones.length > 0 && (
    <section
      id="testimonios"
      role="region"
      aria-label="Testimonios de clientes"
      class="mx-auto max-w-screen-xl px-4 py-16 md:px-6 md:py-24"
    >
      <Eyebrow text="Testimonios" />
      <h2 class="mt-4 font-display text-h2 text-white">
        Lo que dicen quienes ya trabajaron con nosotros
      </h2>

      {
        resenas.mostrar && resenas.total > 0 && (
          <div class="mt-4 flex flex-wrap items-center gap-2 text-small text-smoke">
            <div
              class="flex items-center gap-1"
              aria-label={`Calificación ${resenas.rating} de 5 estrellas`}
            >
              {Array.from({ length: 5 }).map((_, i) => (
                <Star size={14} filled={i < Math.round(resenas.rating)} />
              ))}
            </div>
            <span class="font-mono">
              {resenas.rating.toFixed(1)} · {resenas.total} reseñas en Google
            </span>
            {resenas.perfilUrl && (
              <a
                href={resenas.perfilUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-violeta transition-colors duration-150 ease-out hover:text-violeta-deep"
              >
                Ver todas en Google
              </a>
            )}
          </div>
        )
      }

      {/* Escritorio/tablet: arrastras vos, con mouse o trackpad. */}
      <ul class="pista m-0 mt-8 hidden list-none p-0 md:flex" tabindex="0">
        {opiniones.map((o) => (
          <li>
            <OpinionCard opinion={o} />
          </li>
        ))}
      </ul>

      {/* Móvil: avanza solo. El checkbox oculto es el control de pausa —
          100% CSS, sin JS, y accesible por teclado/lector de pantalla. */}
      <div
        class="marquee-viewport mt-8 md:hidden"
        style={`--marquee-duration: ${duracionMarquee}`}
      >
        <input type="checkbox" id="pausar-testimonios" class="peer sr-only" />

        <ul class="marquee-track m-0 list-none p-0">
          {opiniones.map((o) => (
            <li class="marquee-item">
              <OpinionCard opinion={o} />
            </li>
          ))}
          {opiniones.map((o) => (
            <li class="marquee-item" aria-hidden="true" inert>
              <OpinionCard opinion={o} />
            </li>
          ))}
        </ul>

        <label
          for="pausar-testimonios"
          class="mt-4 inline-block cursor-pointer text-eyebrow font-mono uppercase text-smoke peer-checked:hidden"
        >
          Pausar autoplay
        </label>
        <label
          for="pausar-testimonios"
          class="mt-4 hidden cursor-pointer text-eyebrow font-mono uppercase text-violeta peer-checked:inline-block"
        >
          Reanudar autoplay
        </label>
      </div>
    </section>
  )
}

<style>
  .pista {
    gap: var(--space-16);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-8);
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  .pista > * {
    scroll-snap-align: start;
    flex: 0 0 clamp(280px, 80vw, 360px);
  }

  .marquee-viewport {
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    gap: var(--space-16);
    width: max-content;
    animation: testimonios-marquee var(--marquee-duration, 24s) linear infinite;
  }
  .marquee-item {
    flex: 0 0 clamp(280px, 80vw, 360px);
  }
  @keyframes testimonios-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - var(--space-16) / 2));
    }
  }
  #pausar-testimonios:checked ~ .marquee-track,
  .marquee-track:hover,
  .marquee-track:focus-within {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }
    .marquee-viewport {
      display: none;
    }
    .pista {
      display: flex !important;
    }
  }
</style>
