---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  size?: "sm" | "md";
  type?: "button" | "submit";
  target?: string;
  rel?: string;
  class?: string;
  "aria-label"?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  target,
  rel,
  class: className,
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-body font-medium transition-colors duration-150 ease-out";

const variants = {
  primary:
    size === "sm"
      ? "bg-senal text-ink px-4 py-2 text-small rounded-button hover:bg-senal-deep"
      : "bg-senal text-ink px-6 py-3 rounded-button hover:bg-senal-deep",
  secondary: "text-violeta hover:text-violeta-deep",
};

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  target={href ? target : undefined}
  rel={href ? rel : undefined}
  type={href ? undefined : type}
  class:list={[base, variants[variant], className]}
  {...rest}
>
  <slot />
</Tag>
