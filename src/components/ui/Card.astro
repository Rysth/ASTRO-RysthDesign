---
export interface Props {
  border?: "slate" | "violeta";
  padding?: "sm" | "md" | "lg";
  class?: string;
}

const { border = "slate", padding = "md", class: className } = Astro.props;

const borders = {
  slate: "border-slate",
  violeta: "border-violeta",
};

const paddings = {
  sm: "p-4",
  md: "p-6",
  lg: "p-8",
};
---

<div
  class:list={[
    "bg-carbon rounded-card border",
    borders[border],
    paddings[padding],
    className,
  ]}
>
  <slot />
</div>
