---

<button
  id="scroll-to-top"
  type="button"
  aria-label="Volver arriba"
  class="fixed bottom-6 right-6 z-50 flex h-11 w-11 translate-y-4 items-center justify-center rounded-full border border-slate bg-carbon text-white opacity-0 shadow-lg transition-all duration-200 ease-out pointer-events-none hover:border-violeta hover:text-violeta"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M18 15l-6-6-6 6" />
  </svg>
</button>

<script>
  const button = document.getElementById("scroll-to-top");

  if (button) {
    const show = () => {
      const visible = window.scrollY > 480;
      button.classList.toggle("opacity-0", !visible);
      button.classList.toggle("pointer-events-none", !visible);
      button.classList.toggle("translate-y-4", !visible);
      button.classList.toggle("translate-y-0", visible);
    };

    show();
    window.addEventListener("scroll", show, { passive: true });

    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>
