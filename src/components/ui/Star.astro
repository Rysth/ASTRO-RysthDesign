---
export interface Props {
  size?: number;
  filled?: boolean;
  color?: "violeta" | "smoke";
  class?: string;
}

const { size = 16, filled = true, color = "violeta", class: className } = Astro.props;

const colors = {
  violeta: "text-violeta",
  smoke: "text-smoke",
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? "currentColor" : "none"}
  stroke="currentColor"
  stroke-width={filled ? 0 : 1.5}
  aria-hidden="true"
  class:list={[colors[color], "shrink-0", className]}
>
  <path
    d="M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.9-6.2 3.9 1.6-7-5.4-4.7 7.1-.6L12 2.5z"
  ></path>
</svg>
