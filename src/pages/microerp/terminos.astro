---
import Layout from "@/layouts/Layout.astro";
import { CITY } from "@/data/site.ts";
import { planes } from "@/data/planes.ts";

const actualizado = "12 de noviembre de 2026";
const plan = planes.find((p) => p.slug === "microerp")!;
const correo = "support@rysthdesign.com";

// Cada sección: título y párrafos (o lista con `items`).
interface Seccion {
  titulo: string;
  parrafos?: string[];
  items?: string[];
  despues?: string[];
}

const secciones: Seccion[] = [
  {
    titulo: "1. El servicio",
    parrafos: [
      "MicroERP es un sistema en línea para llevar el inventario, las compras, las ventas, los cobros y la facturación electrónica del SRI de un negocio. Se usa desde el navegador; RysthDesign lo aloja, lo mantiene y lo actualiza.",
      "Cada cliente tiene su propia base de datos, separada de la de los demás clientes.",
      "Podemos mejorar o cambiar funciones del sistema. Si un cambio quita algo importante que usted ya paga, le avisamos con al menos 30 días.",
    ],
  },
  {
    titulo: "2. Instalación, mensualidad y pagos",
    parrafos: [
      `Instalación: $${plan.setup}, en dos pagos de $${plan.setup / 2}. El primero al empezar; el segundo cuando su sistema ya está funcionando. Incluye la configuración con su logo, bodega y formas de pago, y hasta 5 usuarios. No incluye cargar su catálogo ni capacitaciones, salvo que se acuerden aparte.`,
      `Mensualidad: $${plan.mensual} al mes desde el segundo mes (el primero es gratis), o $250 por un año completo. Incluye alojamiento, actualizaciones, respaldos y soporte según la sección 3.`,
    ],
    items: plan.complementos.map((c) => `${c.nombre}: ${c.precio}.`),
    despues: [
      "Los precios publicados son el precio final. El pago es por transferencia bancaria o el medio que le indiquemos; la mensualidad se paga por adelantado y el año completo, al inicio.",
      "Si un pago no llega a tiempo, le avisamos y tiene 7 días de gracia. Pasado ese plazo, el servicio puede suspenderse; sus datos se conservan según la sección 6.",
      "Los precios pueden cambiar con aviso de al menos 30 días, y el cambio se aplica desde el siguiente periodo que pague.",
      "Sin permanencia: avisa con un mes y deja de pagar. No se devuelve el dinero de un periodo ya empezado ni el primer pago de la instalación una vez empezado el trabajo, salvo que la ley lo exija.",
    ],
  },
  {
    titulo: "3. Soporte",
    parrafos: [
      "Atendemos por WhatsApp los errores del sistema (algo que no funciona como debe), de lunes a viernes en horario de oficina.",
      "Los planes no incluyen capacitaciones en vivo. La carga del catálogo y cualquier cambio a la medida son servicios aparte, con precio acordado antes de empezar.",
    ],
  },
  {
    titulo: "4. Sus responsabilidades",
    items: [
      "Cuidar sus usuarios y contraseñas, y avisarnos si cree que alguien más entró a su cuenta.",
      "La información que registra: productos, precios, clientes, ventas y lo que factura.",
      "Facturación electrónica: usted es el emisor ante el SRI. Responde por el contenido de sus facturas y notas de crédito, por su firma electrónica (.p12) y por mantenerla vigente, y por estar al día con sus obligaciones tributarias. MicroERP solo envía al SRI lo que usted decide emitir.",
      "Tener derecho a usar los datos personales que registra de sus propios clientes (ver sección 7).",
      "No usar MicroERP para actividades ilegales ni para intentar entrar a datos de otros clientes o dañar el sistema.",
    ],
  },
  {
    titulo: "5. Disponibilidad y respaldos",
    parrafos: [
      "Hacemos lo razonable para que MicroERP esté disponible todos los días, pero no podemos garantizar que nunca falle. Puede haber cortes por mantenimiento (de preferencia en la noche) o por fallas de terceros, como el proveedor del servidor, internet o los servicios del SRI.",
      "Hacemos respaldos automáticos diarios de la base de datos y de los archivos, guardados en un lugar distinto del servidor principal.",
    ],
  },
  {
    titulo: "6. Sus datos son suyos",
    parrafos: [
      "Todo lo que registra en MicroERP es suyo. No lo vendemos, no lo compartimos y no lo usamos para nada que no sea prestarle el servicio.",
      "Al terminar el servicio, puede pedir dentro de 30 días una copia de sus productos, clientes y ventas en Excel, y de sus facturas electrónicas (XML y PDF). Pasados 60 días desde el fin del servicio, sus datos se eliminan de forma definitiva, incluidos los respaldos en su siguiente ciclo, salvo lo que la ley obligue a conservar.",
    ],
  },
  {
    titulo: "7. Tratamiento de datos personales",
    parrafos: [
      "Esta sección sigue la Ley Orgánica de Protección de Datos Personales del Ecuador (LOPDP) y su reglamento.",
      "Roles: usted es el responsable del tratamiento de los datos personales que registra en MicroERP (por ejemplo, nombre, cédula o RUC, teléfono, correo y dirección de sus clientes, proveedores y vendedoras). RysthDesign es el encargado del tratamiento: los trata solo por cuenta de usted y para prestar el servicio.",
      "Para qué se tratan: solo para que MicroERP funcione. Esto incluye guardar los datos y mostrarlos a sus usuarios, emitir sus comprobantes electrónicos ante el SRI, enviar los mensajes que usted ordene, hacer respaldos y dar soporte. Solo seguimos sus instrucciones; si alguna nos parece contraria a la ley, se lo decimos.",
      "Confidencialidad: quienes en RysthDesign puedan acceder a los datos están obligados a guardar reserva, incluso después de terminar su relación con nosotros, y solo acceden cuando hace falta (por ejemplo, para resolver un error que usted reportó).",
      "Seguridad: conexión cifrada (HTTPS), una base de datos separada por cliente, contraseñas guardadas cifradas, accesos por rol, respaldos diarios fuera del servidor principal, acceso de administración limitado y actualizaciones de seguridad.",
      "Proveedores: usamos proveedores de servidores y de almacenamiento de respaldos en la nube, a quienes exigimos un nivel de protección equivalente. Si alguno guarda datos fuera del Ecuador, nos aseguramos de que ofrezca garantías adecuadas, conforme a la LOPDP. Le avisamos antes de cambiar de proveedor.",
      "Derechos de las personas: si alguien le pide acceder, corregir, actualizar o eliminar sus datos, u oponerse a su uso, puede hacerlo desde MicroERP; si no puede, le ayudamos. Si la solicitud nos llega a nosotros, se la reenviamos.",
      "Incidentes: si detectamos una vulneración que afecte datos personales que usted registró, le avisamos sin demora y en un máximo de 48 horas, con la información disponible, para que pueda notificar a la Autoridad de Protección de Datos y a los afectados cuando corresponda.",
      "Al terminar el servicio se aplica la sección 6: copia a su pedido y luego eliminación.",
    ],
  },
  {
    titulo: "8. Propiedad del software",
    parrafos: [
      "MicroERP, su diseño y sus módulos propios son de RysthDesign. Usted recibe el derecho a usarlo mientras esté al día con la mensualidad; no lo compra ni puede revenderlo. Partes del sistema usan software de código abierto, que se rige por sus propias licencias.",
    ],
  },
  {
    titulo: "9. Responsabilidad",
    parrafos: [
      "Respondemos por prestar el servicio con diligencia. No respondemos por pérdidas por cortes o fallas de terceros (servidor, internet, SRI), por errores en la información que usted registra, por multas o sanciones tributarias por el contenido de sus facturas o por una firma electrónica vencida, ni por el uso indebido de sus cuentas.",
      "En cualquier caso, nuestra responsabilidad se limita a lo que usted pagó en los últimos 3 meses de servicio, salvo dolo o lo que la ley no permita limitar.",
    ],
  },
  {
    titulo: "10. Suspensión y terminación",
    parrafos: [
      "Podemos suspender una cuenta por falta de pago (sección 2), o de inmediato si se usa para actividades ilegales o pone en riesgo el sistema o a otros clientes.",
      "Puede terminar el servicio cuando quiera, avisando por WhatsApp o correo.",
    ],
  },
  {
    titulo: "11. Cambios a estos términos",
    parrafos: [
      "Si actualizamos estos términos, le avisamos con al menos 30 días. Si no está de acuerdo, puede terminar el servicio antes de que el cambio entre en vigor.",
    ],
  },
  {
    titulo: "12. Ley y jurisdicción",
    parrafos: [
      `Estos términos se rigen por las leyes del Ecuador. Cualquier controversia se intentará resolver primero de forma directa y, si no se logra, ante los jueces competentes de ${CITY}.`,
    ],
  },
];
---

<Layout
  title="Términos de MicroERP | RysthDesign"
  description="Condiciones de uso de MicroERP: instalación, mensualidad, pagos, soporte, respaldos y tratamiento de datos personales."
  noindex
>
  <div class="mx-auto max-w-screen-md px-4 py-16 md:px-6 md:py-24">
    <h1 class="text-h2 text-white">Términos de servicio de MicroERP</h1>
    <p class="mt-2 text-small font-mono text-smoke">
      Última actualización: {actualizado}
    </p>

    <div class="mt-10 flex flex-col gap-8 text-body text-smoke">
      <p>
        Estas condiciones aplican al uso de MicroERP, el sistema de inventario,
        compras y ventas de RysthDesign. Al pagar la instalación, usted las acepta. Para los servicios de diseño y desarrollo web aplican
        los <a href="/terminos" class="text-violeta underline underline-offset-4">términos generales</a>.
      </p>

      {
        secciones.map((s) => (
          <section>
            <h2 class="text-h3 text-white">{s.titulo}</h2>
            {s.parrafos?.map((p) => <p class="mt-3">{p}</p>)}
            {s.items && (
              <ul class="mt-3 flex list-disc flex-col gap-2 pl-5">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            )}
            {s.despues?.map((p) => <p class="mt-3">{p}</p>)}
          </section>
        ))
      }

      <section>
        <h2 class="text-h3 text-white">13. Contacto</h2>
        <p class="mt-3">
          Escríbanos a
          <a href={`mailto:${correo}`} class="text-violeta underline underline-offset-4">{correo}</a>
          o por WhatsApp.
        </p>
      </section>
    </div>
  </div>
</Layout>
