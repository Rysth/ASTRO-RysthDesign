---
import Layout from "@/layouts/Layout.astro";
import { CITY } from "@/data/site.ts";
import { planes } from "@/data/planes.ts";

const actualizado = "10 de noviembre de 2026";
const plan = planes.find((p) => p.slug === "microerp")!;
const niveles = plan.niveles ?? [];
const correo = "support@rysthdesign.com";

// Cada sección: título y párrafos (o lista con `items`).
interface Seccion {
  titulo: string;
  parrafos?: string[];
  items?: string[];
  despues?: string[];
}

const secciones: Seccion[] = [
  {
    titulo: "1. El servicio",
    parrafos: [
      "MicroERP es un sistema en línea para llevar el inventario, las compras, las ventas, los cobros y la facturación electrónica del SRI de un negocio. Se usa desde el navegador; RysthDesign lo aloja, lo mantiene y lo actualiza.",
      "Cada cliente tiene su propia base de datos, separada de la de los demás clientes.",
      "Podemos mejorar o cambiar funciones del sistema. Si un cambio quita algo importante que ya pagas, te avisamos con al menos 30 días.",
    ],
  },
  {
    titulo: "2. Prueba gratis, planes y pagos",
    parrafos: [
      `Prueba gratis: ${plan.prueba} días, sin tarjeta. Al terminar, eliges un plan o la cuenta se suspende. Si eliges un plan, conservas todo lo que cargaste durante la prueba. Si no, tus datos se eliminan 30 días después.`,
    ],
    items: niveles.map(
      (n) => `Plan ${n.nombre}: $${n.mensual} al mes o $${n.anual} al año. ${n.incluye.join(", ")}.`,
    ),
    despues: [
      "Los precios son finales, sin IVA adicional. El pago es por adelantado, por transferencia bancaria o el medio que te indiquemos. El plan anual se paga completo al inicio.",
      "Si un pago no llega a tiempo, te avisamos y tienes 7 días de gracia. Pasado ese plazo, la cuenta puede suspenderse; tus datos se conservan según la sección 6.",
      "Los precios pueden cambiar con aviso de al menos 30 días, y el cambio se aplica desde el siguiente periodo que pagues.",
      "Sin permanencia: puedes dejar de pagar cuando quieras. No se devuelve el dinero de un periodo ya empezado, salvo que la ley lo exija.",
      "Pausa: en temporada baja puedes pausar tu cuenta por $3 al mes. Mientras está pausada no puedes usar el sistema, pero tus datos se conservan.",
    ],
  },
  {
    titulo: "3. Soporte",
    parrafos: [
      "Atendemos por WhatsApp los errores del sistema (algo que no funciona como debe), de lunes a viernes en horario de oficina.",
      "Las dudas de uso se resuelven con los videos y las preguntas frecuentes de MicroERP. Las capacitaciones en vivo no están incluidas en los planes.",
      "«Te lo dejamos listo» (carga del catálogo) es un servicio aparte, con precio acordado antes de empezar.",
    ],
  },
  {
    titulo: "4. Tus responsabilidades",
    items: [
      "Cuidar tus usuarios y contraseñas, y avisarnos si crees que alguien más entró a tu cuenta.",
      "La información que registras: productos, precios, clientes, ventas y lo que facturas.",
      "Facturación electrónica: tú eres el emisor ante el SRI. Respondes por el contenido de tus facturas y notas de crédito, por tu firma electrónica (.p12) y por mantenerla vigente, y por estar al día con tus obligaciones tributarias. MicroERP solo envía al SRI lo que tú decides emitir.",
      "Tener derecho a usar los datos personales que registras de tus propios clientes (ver sección 7).",
      "No usar MicroERP para actividades ilegales ni para intentar entrar a datos de otros clientes o dañar el sistema.",
    ],
  },
  {
    titulo: "5. Disponibilidad y respaldos",
    parrafos: [
      "Hacemos lo razonable para que MicroERP esté disponible todos los días, pero no podemos garantizar que nunca falle. Puede haber cortes por mantenimiento (de preferencia en la noche) o por fallas de terceros, como el proveedor del servidor, internet o los servicios del SRI.",
      "Hacemos respaldos automáticos diarios de la base de datos y de los archivos, guardados en un lugar distinto del servidor principal.",
    ],
  },
  {
    titulo: "6. Tus datos son tuyos",
    parrafos: [
      "Todo lo que registras en MicroERP es tuyo. No lo vendemos, no lo compartimos y no lo usamos para nada que no sea prestarte el servicio.",
      "Al terminar el servicio, puedes pedir dentro de 30 días una copia de tus productos, clientes y ventas en Excel, y de tus facturas electrónicas (XML y PDF). Pasados 60 días desde el fin del servicio, tus datos se eliminan de forma definitiva, incluidos los respaldos en su siguiente ciclo, salvo lo que la ley obligue a conservar.",
    ],
  },
  {
    titulo: "7. Tratamiento de datos personales",
    parrafos: [
      "Esta sección sigue la Ley Orgánica de Protección de Datos Personales del Ecuador (LOPDP) y su reglamento.",
      "Roles: tú eres el responsable del tratamiento de los datos personales que registras en MicroERP (por ejemplo, nombre, cédula o RUC, teléfono, correo y dirección de tus clientes, proveedores y vendedoras). RysthDesign es el encargado del tratamiento: los trata solo por tu cuenta y para prestar el servicio.",
      "Para qué se tratan: solo para que MicroERP funcione. Esto incluye guardar los datos y mostrarlos a tus usuarios, emitir tus comprobantes electrónicos ante el SRI, enviar los mensajes que tú ordenes, hacer respaldos y dar soporte. Solo seguimos tus instrucciones; si alguna nos parece contraria a la ley, te lo decimos.",
      "Confidencialidad: quienes en RysthDesign puedan acceder a los datos están obligados a guardar reserva, incluso después de terminar su relación con nosotros, y solo acceden cuando hace falta (por ejemplo, para resolver un error que reportaste).",
      "Seguridad: conexión cifrada (HTTPS), una base de datos separada por cliente, contraseñas guardadas cifradas, accesos por rol, respaldos diarios fuera del servidor principal, acceso de administración limitado y actualizaciones de seguridad.",
      "Proveedores: usamos proveedores de servidores y de almacenamiento de respaldos en la nube, a quienes exigimos un nivel de protección equivalente. Si alguno guarda datos fuera del Ecuador, nos aseguramos de que ofrezca garantías adecuadas, conforme a la LOPDP. Te avisamos antes de cambiar de proveedor.",
      "Derechos de las personas: si alguien te pide acceder, corregir, actualizar o eliminar sus datos, u oponerse a su uso, puedes hacerlo desde MicroERP; si no puedes, te ayudamos. Si la solicitud nos llega a nosotros, te la reenviamos.",
      "Incidentes: si detectamos una vulneración que afecte datos personales tuyos, te avisamos sin demora y en un máximo de 48 horas, con la información disponible, para que puedas notificar a la Autoridad de Protección de Datos y a los afectados cuando corresponda.",
      "Al terminar el servicio se aplica la sección 6: copia a tu pedido y luego eliminación.",
    ],
  },
  {
    titulo: "8. Propiedad del software",
    parrafos: [
      "MicroERP, su diseño y sus módulos propios son de RysthDesign. Recibes el derecho a usarlo mientras tu plan esté vigente; no lo compras ni puedes revenderlo. Partes del sistema usan software de código abierto, que se rige por sus propias licencias.",
    ],
  },
  {
    titulo: "9. Responsabilidad",
    parrafos: [
      "Respondemos por prestar el servicio con diligencia. No respondemos por pérdidas por cortes o fallas de terceros (servidor, internet, SRI), por errores en la información que registras, por multas o sanciones tributarias por el contenido de tus facturas o por una firma electrónica vencida, ni por el uso indebido de tus cuentas.",
      "En cualquier caso, nuestra responsabilidad se limita a lo que pagaste en los últimos 3 meses de servicio, salvo dolo o lo que la ley no permita limitar.",
    ],
  },
  {
    titulo: "10. Suspensión y terminación",
    parrafos: [
      "Podemos suspender una cuenta por falta de pago (sección 2), o de inmediato si se usa para actividades ilegales o pone en riesgo el sistema o a otros clientes.",
      "Puedes terminar el servicio cuando quieras, avisando por WhatsApp o correo.",
    ],
  },
  {
    titulo: "11. Cambios a estos términos",
    parrafos: [
      "Si actualizamos estos términos, te avisamos con al menos 30 días. Si no estás de acuerdo, puedes terminar el servicio antes de que el cambio entre en vigor.",
    ],
  },
  {
    titulo: "12. Ley y jurisdicción",
    parrafos: [
      `Estos términos se rigen por las leyes del Ecuador. Cualquier controversia se intentará resolver primero de forma directa y, si no se logra, ante los jueces competentes de ${CITY}.`,
    ],
  },
];
---

<Layout
  title="Términos de MicroERP | RysthDesign"
  description="Condiciones de uso de MicroERP: prueba gratis, planes, pagos, soporte, respaldos y tratamiento de datos personales."
  noindex
>
  <div class="mx-auto max-w-screen-md px-4 py-16 md:px-6 md:py-24">
    <h1 class="text-h2 text-white">Términos de servicio de MicroERP</h1>
    <p class="mt-2 text-small font-mono text-smoke">
      Última actualización: {actualizado}
    </p>

    <div class="mt-10 flex flex-col gap-8 text-body text-smoke">
      <p>
        Estas condiciones aplican al uso de MicroERP, el sistema de inventario,
        compras y ventas de RysthDesign. Al empezar la prueba gratis o pagar un
        plan, las aceptas. Para los servicios de diseño y desarrollo web aplican
        los <a href="/terminos" class="text-violeta underline underline-offset-4">términos generales</a>.
      </p>

      {
        secciones.map((s) => (
          <section>
            <h2 class="text-h3 text-white">{s.titulo}</h2>
            {s.parrafos?.map((p) => <p class="mt-3">{p}</p>)}
            {s.items && (
              <ul class="mt-3 flex list-disc flex-col gap-2 pl-5">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            )}
            {s.despues?.map((p) => <p class="mt-3">{p}</p>)}
          </section>
        ))
      }

      <section>
        <h2 class="text-h3 text-white">13. Contacto</h2>
        <p class="mt-3">
          Escríbenos a
          <a href={`mailto:${correo}`} class="text-violeta underline underline-offset-4">{correo}</a>
          o por WhatsApp.
        </p>
      </section>
    </div>
  </div>
</Layout>
