---
import Layout from "@/layouts/Layout.astro";
import HeroVeterinarias from "@/components/sections/HeroVeterinarias.astro";
import AuditoriaVeterinarias from "@/components/sections/AuditoriaVeterinarias.astro";
import DemoVeterinarias from "@/components/sections/DemoVeterinarias.astro";
import IncluyeVeterinarias from "@/components/sections/IncluyeVeterinarias.astro";
import Resenas from "@/components/Resenas.astro";
import FaqVeterinarias from "@/components/sections/FaqVeterinarias.astro";
import CtaFinal from "@/components/sections/CtaFinal.astro";
---

<Layout
  title="Página web para veterinarias en Guayaquil | RysthDesign"
  description="Sitios web para veterinarias en Guayaquil. Precios visibles, agenda por WhatsApp, carga en menos de 1 segundo. Entrega en 7 días."
  canonical="https://rysthdesign.com/veterinarias"
>
  <HeroVeterinarias />
  <AuditoriaVeterinarias />
  <DemoVeterinarias />
  <IncluyeVeterinarias />
  <Resenas />
  <FaqVeterinarias />
  <CtaFinal
    titulo="¿Listo para que tu veterinaria aparezca en Google?"
    mensaje="Hola, tengo una veterinaria y quiero saber cómo funciona el sistema de RysthDesign."
  />
</Layout>
